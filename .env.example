# Copy to .env.local. Never put real credentials in this file.
APP_BASE_URL=http://localhost:3000

# Wildcard customer subdomains are attached to the shared Vercel project.
LUCIA_SITE_DOMAIN=lucia.name.ng

# LUCIA Core Consumer Contract v1 (server-side only).
# Configure only after the Core consumer is provisioned out of band.
LUCIA_CORE_ISSUER=
LUCIA_CORE_CLIENT_ID=
LUCIA_CORE_CLIENT_SECRET=
LUCIA_CORE_AUDIENCE=
LUCIA_CORE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Neon PostgreSQL. Keep development, preview, and production databases separate.
DATABASE_URL=

# S3-compatible object storage (server-side only).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Configure when an email workflow is implemented.
EMAIL_PROVIDER_API_KEY=
