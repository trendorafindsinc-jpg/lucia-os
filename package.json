{
  "name": "lucia-os",
  "version": "0.1.0",
  "private": true,
  "description": "LUCIA OS universal multi-tenant website platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-routing-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test:routing:http": "node scripts/check-routing-http.mjs"
  },
  "dependencies": {
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@eslint/eslintrc": "^3.3.1",
    "drizzle-kit": "^0.31.5"
  },
  "overrides": {
    "rollup": "4.65.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
